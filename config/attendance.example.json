{
  "schemaVersion": 2,
  "enabled": false,
  "automaticChromeClicks": false,
  "site": {
    "attendanceUrl": "https://skplanet.atosoft.net/Worknet/Present/Present.asp",
    "authenticationUrl": "https://skplanet.atosoft.net/Worknet/Present/PAuthWay.asp",
    "sessionSource": "existingChrome"
  },
  "location": { "latitude": null, "longitude": null, "radiusMeters": 30 },
  "wifi": { "allowedSsids": ["TACADEMY_5G"], "connectionStrategy": "systemAutoJoin" },
  "schedule": {
    "timezone": "Asia/Seoul",
    "classDays": [1, 2, 3, 4, 5],
    "excludedDates": [],
    "checkInWindow": { "start": "08:30", "end": "09:30" },
    "checkOutTime": "17:50",
    "checkOutRetryMinutes": 10,
    "stopAfterConfirmedAttendance": true
  },
  "notifications": { "attendanceResult": "always", "separateDateAndPhase": true, "autoCancelOnTap": false, "wifiAndChromeActionRequests": true },
  "history": { "source": "recordsObservedInChrome", "olderRecords": "openChrome" }
}
